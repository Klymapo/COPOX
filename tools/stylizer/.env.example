# Copia este archivo como .env. No compartas tu .env.
AGNES_API_KEY=
HF_TOKEN=
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=qwen2.5:3b
# En servidor, template prepara el prompt sin Ollama ni conexión a tu PC.
STYLIZER_PROMPT_MODE=ollama

# Acceso desde el celular: python app.py --mobile
STYLIZER_USER=atatoriz
STYLIZER_PASSWORD=
# server.py exige al menos 12 caracteres. En alojamiento se usa PORT si
# STYLIZER_PORT no está definida; evita fijar STYLIZER_PORT en Render.
STYLIZER_PORT=7860
STYLIZER_DATA_DIR=.stylizer
STYLIZER_OUTPUT_DIR=outputs

# Solo para preparar modelos para Godot, si Blender no se detecta automáticamente.
# BLENDER_PATH=C:/Program Files/Blender Foundation/Blender 4.5/blender.exe
